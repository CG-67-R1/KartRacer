{
  "expo": {
    "name": "KartRacer - Motorsport_Is_Life",
    "slug": "kartracer",
    "owner": "motorsport-is-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.milkartracer.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.milkartracer.app"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "KartRacer uses your calendar to add race events and reminders."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KartRacer uses your photos to set your kart photo and driver avatar, add images to Track Walk notes, and attach photos in Coach."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KartRacer uses your camera to place your face in the driver avatar.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KartRacer uses the microphone to transcribe voice notes in Track Walk.",
          "speechRecognitionPermission": "KartRacer uses speech recognition to transcribe voice notes in Track Walk."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KartRacer uses your location at the circuit to greet you when you arrive and suggest chatting with your coach."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "",
      "termsOfUseUrl": "",
      "eas": {}
    }
  }
}
